# Copy to `.env.alpaca` and fill in values.
#
# IMPORTANT:
# - Keep this file out of git (do not commit `.env.alpaca`).
# - Use paper trading unless you explicitly want to trade live.

# Required
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional (defaults to paper endpoint)
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Optional: set to 1/true/yes to use Alpaca paper trading in alpaca-py
ALPACA_PAPER=true

# Manual test defaults
ALPACA_TEST_SYMBOL=SPY
# For BUY market tests: notional dollars (e.g., 5.00)
ALPACA_TEST_NOTIONAL=5.00
# For SELL market tests: qty shares (e.g., 1)
ALPACA_TEST_QTY=1
# buy|sell
ALPACA_TEST_SIDE=buy
