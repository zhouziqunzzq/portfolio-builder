# Copy to `.env.broker` and fill in values.
#
# IMPORTANT:
# - Keep `.env.broker` out of git (do not commit it).
# - Use paper trading unless you explicitly want to trade live.

# -------------------------------------------------------------------
# Alpaca (alpaca-py)
# -------------------------------------------------------------------

# Required for broker=alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional (defaults to paper endpoint)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: set to 1/true/yes to use Alpaca paper trading in alpaca-py
ALPACA_PAPER=true

# -------------------------------------------------------------------
# Public.com (public_api_sdk)
# -------------------------------------------------------------------

# Required for broker=publicdotcom
PUBLICDOTCOM_API_SECRET_KEY=
PUBLICDOTCOM_DEFAULT_ACCOUNT_NUMBER=

# Optional
PUBLICDOTCOM_BASE_URL=

# Backward-compatible aliases (optional; prefer the PUBLICDOTCOM_* vars)
API_SECRET_KEY=
DEFAULT_ACCOUNT_NUMBER=

# -------------------------------------------------------------------
# Manual test defaults (shared)
# -------------------------------------------------------------------

# Which adapter to test if you omit --broker
BROKER=alpaca

BROKER_TEST_SYMBOL=SPY

# For BUY market tests: notional dollars (e.g., 5.00)
BROKER_TEST_NOTIONAL=5.00

# For SELL market tests: qty shares (e.g., 1)
BROKER_TEST_QTY=1

# buy|sell
BROKER_TEST_SIDE=buy
