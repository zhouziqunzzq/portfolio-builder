# Docker/Compose env_file format (no `export`)
# Alpaca credentials
ALPACA_API_KEY=<YOUR_ALPACA_API_KEY>
ALPACA_SECRET_KEY=<YOUR_ALPACA_SECRET_KEY>
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# OpenTelemetry settings are configured in docker-compose.*.yml (not here),
# so Alpaca secrets remain the only required values in this env file.