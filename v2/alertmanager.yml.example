# Copy this file to `alertmanager.yml` and set your real oncall webhook URL.
#
# IMPORTANT:
# - The prom/alertmanager image used in this repo does NOT expand env vars inside
#   this YAML, so put the literal webhook URL here.

global:
  resolve_timeout: 5m

route:
  receiver: "null"
  group_by: [ "alertname", "service" ]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

  routes:
  # Page-able alerts: route these to pushover-critical.
  - matchers:
    - severity="page"
    receiver: "pushover-critical"
    continue: false

receivers:
- name: "null"

- name: pushover-critical
  pushover_configs:
  - user_key: "<PUSHOVER_USER_KEY>"
    token: "<PUSHOVER_APP_TOKEN>"
    title: "{{ .CommonAnnotations.summary }}"
    message: >-
      {{ range .Alerts -}} {{ .Annotations.description }} {{ end }}
    priority: 1 # high priority
    retry: 60s # retry every 60s
    expire: 1h # keep retrying for 1 hour
